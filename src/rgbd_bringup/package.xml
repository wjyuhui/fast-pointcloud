<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rgbd_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and params for RGB-D perception stack.</description>
  <maintainer email="yuhui@todo.todo">yuhui</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rgbd_pcl</exec_depend>
  <exec_depend>rgbd_bev</exec_depend>
  <exec_depend>rgbd_detection</exec_depend>
  <exec_depend>rgbd_perception_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
